EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
EXPO_PUBLIC_LINE_CHANNEL_ID=your-line-channel-id
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id
EXPO_PUBLIC_APPLE_CLIENT_ID=your-apple-service-id
EXPO_PUBLIC_X_CLIENT_ID=your-x-client-id
EXPO_PUBLIC_EVENTBRITE_TOKEN=your-eventbrite-api-token
EXPO_PUBLIC_OAUTH_REDIRECT_URI=https://your-app.vercel.app/auth/callback
EXPO_PUBLIC_APP_SCHEME=mugimaru
# Optional for local PoC only. Do not expose secrets in production clients.
# Never put OAuth client secrets in EXPO_PUBLIC_* variables. Public Expo
# variables are embedded in the shipped application. Confidential OAuth
# exchanges must run on a server-side callback.
